{
  "manifest_version": 3,
  "name": "OpenTiles",
  "version": "1.0.0",
  "description": "A free, modern, open-source and highly customizable visual bookmark manager and a start page plugin for your browser.",
  "browser_specific_settings": {
    "gecko": {
      "id": "tiles@local.extension",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "chrome_url_overrides": {
    "newtab": "src/newtab.html"
  },
  "chrome_settings_overrides": {
    "homepage": "src/newtab.html"
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
