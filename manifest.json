{
  "manifest_version": 3,
  "name": "Tiles",
  "version": "0.2.0",
  "description": "Replaces the new tab page with a grid of draggable tiles for quick access to your favourite sites.",
  "browser_specific_settings": {
    "gecko": {
      "id": "tiles@local.extension",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "storage"
  ],
  "chrome_url_overrides": {
    "newtab": "src/newtab.html"
  },
  "chrome_settings_overrides": {
    "homepage": "src/newtab.html"
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
